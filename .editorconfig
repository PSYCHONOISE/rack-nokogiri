# Basic editor-level formatting rules are common to all languages in the repository. Language-specific rules (such as indentation width for a specific stack) are overridden at specific points below; more subtle line-level linting/formatting (eslint, black, rubocop) is the responsibility of the service's Makefile, not this file. Also: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.py]
indent_size = 2

[*.rb]
indent_size = 2

[*.js]
indent_size = 2

[*.ts]
indent_size = 2
